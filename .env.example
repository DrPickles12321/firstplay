# FirstPlay: copy to .env. Never commit .env.
FIRSTPLAY_PROVIDER=codex
PORT=3211

# Codex uses your existing CLI login. Optional model override:
CODEX_MODEL=
# Optional absolute Codex CLI path (otherwise PATH is used):
CODEX_BIN=

# Twitch application: register this redirect URI exactly.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3211/auth/callback

# Optional API provider, only if you choose FIRSTPLAY_PROVIDER=openai:
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional viewer-only HTTPS gateway; see README before exposing it.
FIRSTPLAY_VIEWER_ORIGIN=
FIRSTPLAY_VIEWER_PORT=3212
